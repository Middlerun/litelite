  "tokenColors": [
    {
      "settings": {
        "foreground": "#202020"
      }
    },
    {
      "name": "Punctuation and operators",
      "scope": [
        "punctuation",
        "meta.brace",
        "keyword.operator",
        "storage.type.function.arrow",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#939393"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.default",
        "keyword.control.from",
        "keyword.control.as",
        "keyword.control.type",
        "keyword.control.require",
        "keyword.control.satisfies",
        "keyword.control.new",
        "keyword.control.directive",
        "keyword.control.module",
        "keyword.control.intrinsic",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.word",
        "keyword.operator.logical.python",
        "keyword.operator.sizeof",
        "keyword.operator.alignof",
        "keyword.operator.cast",
        "keyword.operator.type.asserts",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#a3a3a3",
        "background": "#00000000"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.switch",
        "keyword.control.trycatch",
        "keyword.control.exception",
        "keyword.control.with",
        "keyword.control.assert",
        "keyword.operator.ternary"
      ],
      "settings": {
        "foreground": "#a31515",
        "background": "#e028281b"
      }
    },
    {
      "name": "Type declarations",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.alias",
        "entity.name.type.enum",
        "entity.name.type.struct",
        "entity.name.type.trait",
        "entity.name.type.union",
        "entity.name.interface",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.trait",
        "entity.name.union"
      ],
      "settings": {
        "foreground": "#9333ea",
        "background": "#9333ea1c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Declarations (fallback without semantic highlighting)",
      "scope": [
        "meta.definition.function entity.name.function",
        "meta.definition.variable entity.name.function",
        "meta.definition.variable variable.other.constant",
        "meta.definition.variable variable.other.readwrite",
        "entity.name.type.class",
        "entity.name.class",
        "meta.namespace.declaration entity.name.type.module",
        "entity.name.function.python",
        "entity.name.type.class.python"
      ],
      "settings": {
        "foreground": "#000000",
        "background": "#ffdd005c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Near-black overrides",
      "scope": [
        "entity.name.tag",
        "support.class.component",
        "support.class.console",
        "meta.template.expression",
        "meta.embedded",
        "variable.parameter",
        "entity.name.type.module.go",
        "entity.name.package.go",
        "string meta.template.expression"
      ],
      "settings": {
        "foreground": "#202020"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string punctuation.definition.string",
        "string.regexp",
        "string.template",
        "constant.character.escape",
        "support.type.property-name.json",
        "punctuation.support.type.property-name",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#009c39"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment",
        "comment storage",
